<?php
// Security: Initialize session and security helper
require_once '../config/db.php';

$error = '';
$loginAttempted = false;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $loginAttempted = true;
    
    // ===== CSRF TOKEN VALIDATION =====
    if (!isset($_POST['csrf_token']) || !$security->verifyCSRFToken($_POST['csrf_token'])) {
        $error = '⚠️ Security error: Invalid request token. Please try again.';
    } else {
        $email = trim($_POST['email'] ?? '');
        $password = $_POST['password'] ?? '';

        // ===== INPUT VALIDATION =====
        if (empty($email) || empty($password)) {
            $error = '❌ Email and password are required.';
        } elseif (!SecurityHelper::validateEmail($email)) {
            $error = '❌ Invalid email format.';
        } else {
            // ===== RATE LIMITING CHECK =====
            if (!$security->checkLoginAttempts($email)) {
                $error = '⛔ Too many login attempts. Please try again after 15 minutes.';
                $security->logLoginActivity(0, 'admin', $email, false);
            } else {
                $stmt = $conn->prepare("SELECT * FROM placement_admin WHERE email = ?");
                $stmt->execute([$email]);
                $admin = $stmt->fetch();

                // ===== PASSWORD VERIFICATION =====
                if ($admin && password_verify($password, $admin['password'])) {
                    // ===== ADDITIONAL SECURITY CHECKS =====
                    
                    // Check if admin exists in database
                    if (!$admin['admin_id']) {
                        $error = '❌ Admin account not found in system.';
                        $security->recordFailedAttempt($email);
                    } else {
                        // ===== PREVENT CONCURRENT SESSIONS =====
                        if (!$security->preventConcurrentSessions($admin['admin_id'], 'admin')) {
                            $error = '⛔ You already have an active session. Please logout first.';
                            $security->recordFailedAttempt($email);
                        } else {
                            // ===== SUCCESSFUL LOGIN =====
                            $security->clearLoginAttempts($email);
                            
                            // Register login with security
                            $security->registerLogin($admin['admin_id'], 'admin', $email);
                            
                            // Store additional admin data
                            $_SESSION['name'] = $admin['name'];
                            
                            // Redirect to dashboard
                            header('Location: dashboard.php', true, 302);
                            exit;
                        }
                    }
                } else {
                    // ===== FAILED LOGIN =====
                    $error = '❌ Invalid email or password.';
                    $security->recordFailedAttempt($email);
                    
                    // Log failed attempt
                    if (defined('LOG_FAILED_ATTEMPTS') && LOG_FAILED_ATTEMPTS) {
                        error_log("Failed login attempt for admin: $email from IP: " . $security->getClientIP());
                    }
                }
            }
        }
    }
}
?>
