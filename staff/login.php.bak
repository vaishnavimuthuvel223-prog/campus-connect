<?php
// Security: Initialize session and security helper
require_once '../config/db.php';

$error = '';
$loginAttempted = false;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $loginAttempted = true;
    
    // ===== CSRF TOKEN VALIDATION =====
    if (!isset($_POST['csrf_token']) || !$security->verifyCSRFToken($_POST['csrf_token'])) {
        $error = '⚠️ Security error: Invalid request token. Please try again.';
    } else {
        $staffId = trim($_POST['staff_id'] ?? '');
        $password = $_POST['password'] ?? '';

        // ===== INPUT VALIDATION =====
        if (empty($staffId) || empty($password)) {
            $error = '❌ Staff ID and password are required.';
        } else {
            // ===== RATE LIMITING CHECK =====
            if (!$security->checkLoginAttempts($staffId)) {
                $error = '⛔ Too many login attempts. Please try again after 15 minutes.';
                $security->logLoginActivity(0, 'staff', $staffId, false);
            } else {
                $stmt = $conn->prepare("SELECT * FROM department_staff WHERE staff_code = ?");
                $stmt->execute([$staffId]);
                $staff = $stmt->fetch();

                // ===== PASSWORD VERIFICATION =====
                if ($staff && password_verify($password, $staff['password'])) {
                    // ===== ADDITIONAL SECURITY CHECKS =====
                    
                    // Check if staff exists in database
                    if (!$staff['staff_id']) {
                        $error = '❌ Staff member not found in system.';
                        $security->recordFailedAttempt($staffId);
                    } else {
                        // ===== PREVENT CONCURRENT SESSIONS =====
                        if (!$security->preventConcurrentSessions($staff['staff_id'], 'staff')) {
                            $error = '⛔ You already have an active session. Please logout first.';
                            $security->recordFailedAttempt($staffId);
                        } else {
                            // ===== SUCCESSFUL LOGIN =====
                        $security->clearLoginAttempts($staffId);
                        
                        // Register login with security
                        $security->registerLogin($staff['staff_id'], 'staff', $staff['email']);
                            $_SESSION['name'] = $staff['name'];
                            $_SESSION['dept_id'] = $staff['dept_id'];
                            $_SESSION['staff_code'] = $staff['staff_code'] ?? null;
                            
                            // Check if profile is complete
                            if (!$staff['profile_completed']) {
                                // Redirect to complete profile
                                header('Location: complete_profile.php', true, 302);
                            } else {
                                // Redirect to dashboard
                                header('Location: dashboard.php', true, 302);
                            }
                            exit;
                        }
                    }
                } else {
                    // ===== FAILED LOGIN =====
                    $error = '❌ Invalid Staff ID or password.';
                    $security->recordFailedAttempt($staffId);
                    
                    // Log failed attempt
                    if (defined('LOG_FAILED_ATTEMPTS') && LOG_FAILED_ATTEMPTS) {
                        error_log("Failed login attempt for staff: $staffId from IP: " . $security->getClientIP());
                    }
                }
            }
        }
    }
}
?>
